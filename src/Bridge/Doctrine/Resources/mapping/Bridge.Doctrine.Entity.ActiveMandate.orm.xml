<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Key table of the active mandates (ADR 0006, ADR 0014): one row per non-cancelled mandate, rewritten with DBAL by
         the mandate repository in the transaction of every save. Its primary key (tenant, employer number) is the "one
         active mandate per employer" constraint, portable to every platform (a partial unique index is not). -->
    <entity name="TheBeardedBear\UrssafTierceDeclarationPaje\Bridge\Doctrine\Entity\ActiveMandate" table="urssaf_paje_active_mandates" read-only="true">
        <unique-constraints>
            <unique-constraint name="uniq_urssaf_paje_active_mandate_id" columns="mandate_id"/>
        </unique-constraints>
        <id name="tenantId" type="urssaf_paje_tenant_id" column="tenant_id" length="64"/>
        <id name="employerNumber" type="urssaf_paje_employer_number" column="employer_number" length="14"/>
        <field name="mandateId" type="urssaf_paje_mandate_id" column="mandate_id" length="64"/>
    </entity>
</doctrine-mapping>
