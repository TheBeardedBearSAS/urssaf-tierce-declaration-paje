<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Mandate of an employer: the employer identification (number and birth date, ADR 0007) and the timeline are
         embedded as columns. The external reference is the employer's (several mandates share it): it is not unique.
         "One active mandate per (tenant, employer number)" is the key table urssaf_paje_active_mandates (ActiveMandate),
         written in the transaction of every save. "version" is the optimistic lock token of the persistence layer. -->
    <entity name="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Mandate\Mandate" table="urssaf_paje_mandates">
        <indexes>
            <index name="idx_urssaf_paje_mandate_employer" columns="tenant_id,employer_number,registered_at"/>
            <index name="idx_urssaf_paje_mandate_state" columns="tenant_id,state"/>
        </indexes>
        <id name="id" type="urssaf_paje_mandate_id" column="id" length="64">
            <generator strategy="NONE"/>
        </id>
        <field name="version" type="integer" version="true"/>
        <field name="tenantId" type="urssaf_paje_tenant_id" column="tenant_id" length="64"/>
        <field name="externalReference" type="urssaf_paje_external_reference" column="external_reference" length="191"/>
        <field name="employerAccountId" type="urssaf_paje_employer_account_id" column="employer_account_id" length="64"/>
        <field name="origin" type="string" column="origin" length="16" enum-type="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Mandate\MandateOrigin"/>
        <field name="state" type="string" column="state" length="16" enum-type="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Mandate\MandateState"/>
        <embedded name="employer" class="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Employer\EmployerReference" use-column-prefix="false"/>
        <embedded name="timeline" class="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Mandate\MandateTimeline" use-column-prefix="false"/>
    </entity>
</doctrine-mapping>
