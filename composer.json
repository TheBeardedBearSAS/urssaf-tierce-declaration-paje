    "license": "proprietary",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "deptrac/deptrac": "^4.7",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/orm": "^3.5.3",
        "doctrine/persistence": "^3.4.1 || ^4.0",
        "ergebnis/composer-normalize": "^2.56",
        "ergebnis/phpstan-rules": "^2.17",
        "friendsofphp/php-cs-fixer": "^3.95",
        "icanhazstring/composer-unused": "^0.9",
        "infection/infection": "^0.32",
        "maglnet/composer-require-checker": "^4.17",
        "nyholm/psr7": "^1.8.2",
        "php-http/client-common": "^2.7.2",
        "php-http/discovery": "^1.19.3",
        "php-http/httplug": "^2.4.1",
        "php-http/message": "^1.16.1",
        "php-http/mock-client": "^1.6.1",
        "php-http/promise": "^1.2.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpdoc-parser": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest",
        "shipmonk/phpstan-rules": "^4.4",
        "symfony/cache": "^6.4 || ^7.4",
        "symfony/cache-contracts": "^2.5.3 || ^3.4.2",
        "symfony/clock": "^6.4.3 || ^7.4",
        "symfony/console": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4.26 || ^7.4",
        "symfony/error-handler": "^6.4.3 || ^7.4",
        "symfony/event-dispatcher-contracts": "^2.5.3 || ^3.4.2",
        "symfony/framework-bundle": "^6.4.3 || ^7.4",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/lock": "^6.4.3 || ^7.4",
        "symfony/messenger": "^6.4.3 || ^7.4",
        "symfony/polyfill-php83": "^1.31",
        "symfony/property-access": "^6.4.3 || ^7.4",
        "symfony/property-info": "^6.4.3 || ^7.4",
        "symfony/serializer": "^6.4.3 || ^7.4",
        "symfony/string": "^6.4.3 || ^7.4",
        "symfony/translation": "^6.4.3 || ^7.4",
        "symfony/translation-contracts": "^2.5.3 || ^3.4.2",
        "symfony/uid": "^6.4.3 || ^7.4",
        "symfony/validator": "^6.4.3 || ^7.4",
        "symfony/var-dumper": "^6.4.3 || ^7.4",
        "symfony/var-exporter": "^6.4.3 || ^7.4",
        "symfony/yaml": "^6.4 || ^7.4",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "conflict": {
        "doctrine/dbal": "<4.0",
        "doctrine/doctrine-bundle": "<2.19",
        "doctrine/orm": "<3.5.3",
        "nyholm/psr7": "<1.8.2",
        "symfony/clock": "<6.4.3",
        "symfony/console": "<6.4",
        "symfony/dependency-injection": "<6.4.26",
        "symfony/framework-bundle": "<6.4.3",
        "symfony/http-client": "<6.4",
        "symfony/http-kernel": "<6.4",
        "symfony/lock": "<6.4.3",
        "symfony/messenger": "<6.4.3"
    },
    "autoload": {
        "psr-4": {
            "TheBeardedBear\\UrssafTierceDeclarationPaje\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheBeardedBear\\UrssafTierceDeclarationPaje\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
