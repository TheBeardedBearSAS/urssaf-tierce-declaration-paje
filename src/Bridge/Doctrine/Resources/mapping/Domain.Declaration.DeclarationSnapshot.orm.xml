<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <embeddable name="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Declaration\DeclarationSnapshot">
        <field name="employerNumber" type="urssaf_paje_employer_number" column="employer_number" length="14"/>
        <field name="activity" type="string" column="activity" length="16" enum-type="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Declaration\DeclarationActivity"/>
        <field name="employeeIdentificationKind" type="string" column="employee_identification_kind" length="32" enum-type="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Employee\EmployeeIdentificationKind"/>
        <field name="employeeNumber" type="urssaf_paje_employee_number" column="employee_number" length="14" nullable="true"/>
        <field name="fingerprint" type="urssaf_paje_declaration_fingerprint" column="fingerprint" length="64"/>
        <embedded name="period" class="TheBeardedBear\UrssafTierceDeclarationPaje\Domain\Declaration\DeclarationPeriod" use-column-prefix="false"/>
    </embeddable>
</doctrine-mapping>
